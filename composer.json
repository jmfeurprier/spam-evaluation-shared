{
    "name": "jmf/spam-evaluation-shared",
    "description": "Spam evaluation shared components",
    "license": "mit",
    "type": "library",
    "authors": [
        {
            "name": "Jean-Michel Feurprier"
        }
    ],
    "require": {
        "php": ">=8.3",
        "webmozart/assert": "^1.0|^2.0"
    },
    "require-dev": {
        "overtrue/phplint": "^9.7",
        "phpstan/phpstan": "^2.1.22",
        "phpstan/phpstan-strict-rules": "^2.0.6",
        "phpunit/phpunit": "^12.3.6",
        "rector/rector": "^2.1.4",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Jmf\\SpamEvaluation\\Shared\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jmf\\SpamEvaluation\\Shared\\Tests\\": "tests/src"
        }
    }
}
